+int llama_context::decode_layer_major_prepasses(llama_memory_context_i * mctx) {
+    const int     n_layer  = (int) model.hparams.n_layer();
+    const int64_t n_tokens = (int64_t) balloc->get_n_tokens();
+    lm_progress_total = (int64_t) n_layer * n_tokens;
+    for (int il = 0; il < n_layer - 1; ++il) {
+        int64_t n_done_layer = 0;   // tokens of this layer already submitted
+        if (il > 0) {
+            mctx->lm_rewind();   // memory metadata back to "before ubatch 0", cursor = 0
+        }
+        lm_il0 = il;
+        lm_il1 = il + 1;
+        if (lm_hold) {
+            model.pgrn_scratch_hold(il);   // a new layer epoch: clear the held bitmap
+        }
+        uint32_t iu = 0;
+        do {
+            // cancellation point: a layer-major prefill is ONE decode call for the whole prompt (minutes for a long
+            // one), so poll the host-side abort check before every (layer, ubatch) step
+            if (lm_abort_requested()) {
+                LLAMA_LOG_WARN("%s: layer-major prefill aborted at layer %d/%d, ubatch %u (%u layer passes done)\n",
+                        __func__, il, n_layer, iu, (unsigned) il);
+                return lm_fail(mctx, GGML_STATUS_ABORTED, il > 0 || iu > 0);
+            }
+            ++iu;
+            const auto & ubatch = mctx->get_ubatch();
+            n_outputs = 0;   // pre-pass graphs have no output head
+            ggml_status status;
+            const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx, status);
+            if (!res) {
+                return lm_fail(mctx, status);
+            }
+            n_done_layer += ubatch.n_tokens;
+            lm_progress((int64_t) il * n_tokens + n_done_layer);
+        } while (mctx->next());
+        ++pgrn_lm_passes;
+    }
+    mctx->lm_rewind();   // the final pass re-applies ubatches 0..N-1 itself
+    return 0;
+}
