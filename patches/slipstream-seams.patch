+static void save_qwen35moe_separate(const llama_model * model, const std::string & path) {
+    llama_model_saver saver(model);
+    saver.add_kv_from_model();
+
+    const auto & tensors = llama_internal_get_tensor_map(model);
+    size_t merged_count = 0;
+    for (const auto & [name, tensor] : tensors) {
+        if (name.find(".ffn_gate_up_exps.weight") != std::string::npos) ++merged_count;
+        else saver.add_tensor(tensor);
+    }
+    GGML_ASSERT(merged_count > 0);
+
+    ggml_init_params params = { ggml_tensor_overhead() * merged_count * 2, nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    GGML_ASSERT(ctx != nullptr);
+    std::vector<std::vector<unsigned char>> payloads;
+    payloads.reserve(merged_count * 2);
+    for (const auto & [name, tensor] : tensors) {
+        if (name.find(".ffn_gate_up_exps.weight") == std::string::npos) continue;
+        GGML_ASSERT(tensor->type == GGML_TYPE_F32 && tensor->ne[1] % 2 == 0 && tensor->ne[2] > 0);
+        const size_t role_bytes = (size_t) tensor->ne[0] * (size_t) (tensor->ne[1] / 2) * sizeof(float);
+        const size_t merged_bytes = role_bytes * 2 * (size_t) tensor->ne[2];
+        std::vector<unsigned char> merged(merged_bytes);
+        ggml_backend_tensor_get(tensor, merged.data(), 0, merged.size());
+        payloads.emplace_back(role_bytes * (size_t) tensor->ne[2]);
+        payloads.emplace_back(role_bytes * (size_t) tensor->ne[2]);
+        auto & gate_data = payloads[payloads.size() - 2];
+        auto & up_data   = payloads[payloads.size() - 1];
+        for (int64_t expert = 0; expert < tensor->ne[2]; ++expert) {
+            std::memcpy(gate_data.data() + (size_t) expert * role_bytes,
+                    merged.data() + (size_t) expert * 2 * role_bytes, role_bytes);
+            std::memcpy(up_data.data() + (size_t) expert * role_bytes,
+                    merged.data() + ((size_t) expert * 2 + 1) * role_bytes, role_bytes);
+        }
+        ggml_tensor * gate = ggml_new_tensor_3d(ctx, tensor->type, tensor->ne[0], tensor->ne[1] / 2, tensor->ne[2]);
+        ggml_tensor * up   = ggml_new_tensor_3d(ctx, tensor->type, tensor->ne[0], tensor->ne[1] / 2, tensor->ne[2]);
+        std::string gate_name = name;
+        std::string up_name = name;
+        gate_name.replace(gate_name.find("gate_up"), 7, "gate");
+        up_name.replace(up_name.find("gate_up"), 7, "up");
+        ggml_set_name(gate, gate_name.c_str());
+        ggml_set_name(up, up_name.c_str());
+        gate->data = gate_data.data();
+        up->data = up_data.data();
+        saver.add_tensor(gate);
+        saver.add_tensor(up);
+    }
+    saver.save(path);
+    ggml_free(ctx);
+}
