+
+int llama_model::pgrn_resolve_slots(
+        uint16_t layer, int32_t * expert_ids, size_t expert_id_count,
+        size_t * fetched, char * error, size_t error_capacity) const {
+    if (fetched) *fetched = 0;
+    if (!pgrn_compact_enabled() || (!expert_ids && expert_id_count != 0)) return -1;
+    pgr_runtime_batch_begin(pimpl->pgrn_runtime, layer);
+    for (size_t i = 0; i < expert_id_count; ++i) {
+        const int32_t original = expert_ids[i];
+        if (original < 0 || original > UINT16_MAX) {
+            if (error && error_capacity) std::snprintf(error, error_capacity, "%s", "selected expert id is outside PGRN keys");
+            return -1;
+        }
+        const void * data = nullptr;
+        size_t data_size = 0;
+        int hit = 0;
+        int slot = -1;
+        uint64_t generation = 0;
+        const pgr_stream_status status = pgr_runtime_get_slot(
+                pimpl->pgrn_runtime, layer, static_cast<uint16_t>(original),
+                &data, &data_size, &hit, &slot, &generation);
+        GGML_UNUSED(data);
+        GGML_UNUSED(data_size);
+        GGML_UNUSED(generation);
+        if (status != PGR_STREAM_OK || slot < 0 || static_cast<size_t>(slot) >= pgrn_compact_capacity(layer)) {
+            if (error && error_capacity) std::snprintf(error, error_capacity, "%s", pgr_runtime_error(pimpl->pgrn_runtime));
+            return -1;
+        }
+        expert_ids[i] = slot;
+        if (!hit && fetched) (*fetched)++;
+    }
+    if (error && error_capacity) error[0] = '\0';
+    return 0;
+}
+
+int llama_model::pgrn_stage(uint16_t layer, const int32_t * expert_ids, size_t expert_id_count,
+        size_t * copied, size_t * uploaded, uint64_t * fetch_us, uint64_t * upload_us,
+        char * error, size_t error_capacity) const {
+    if (copied) *copied = 0;
+    if (uploaded) *uploaded = 0;
+    if (fetch_us) *fetch_us = 0;
+    if (upload_us) *upload_us = 0;
+    if (!pgrn_enabled()) return -1;
+    pgr_stage_stats stats{};
+    const int result = pgr_scratch_stage(pimpl->pgrn_scratch, pimpl->pgrn_runtime,
+            layer, expert_ids, expert_id_count, &stats, error, error_capacity);
+    if (copied) *copied = stats.experts_copied;
+    if (uploaded) *uploaded = stats.bytes_uploaded;
+    if (fetch_us) *fetch_us = stats.fetch_us;
+    if (upload_us) *upload_us = stats.upload_us;
+    return result;
+}
