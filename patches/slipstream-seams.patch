+// Slipstream — grammar-forced draft support. If `smpl` is a grammar sampler with an active
+// grammar, return the UTF-8 bytes of the currently-forced span (else 0). Non-mutating.
+size_t llama_sampler_grammar_forced_span(const struct llama_sampler * smpl, char * out, size_t out_cap, int max_chars) {
+    if (!smpl || !smpl->iface || smpl->iface->name != llama_sampler_grammar_name) {
+        return 0;
+    }
+    const auto * ctx = (const llama_sampler_grammar *) smpl->ctx;
+    if (!ctx || !ctx->grammar) {
+        return 0;
+    }
+    return llama_grammar_forced_span(ctx->grammar, out, out_cap, max_chars);
+}
