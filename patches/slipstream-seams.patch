+// Byte-level UTF-8 encode of a code point; returns bytes written (1..4), 0 if invalid.
+static size_t llama_grammar_utf8_encode(uint32_t cp, char out[4]) {
+    if (cp <= 0x7F)     { out[0] = (char) cp; return 1; }
+    if (cp <= 0x7FF)    { out[0] = (char)(0xC0 | (cp >>  6)); out[1] = (char)(0x80 | (cp & 0x3F)); return 2; }
