+bool llama_model::pgrn_enabled() const {
+    return pimpl->pgrn_runtime != nullptr && pimpl->pgrn_scratch != nullptr;
+}
+
+bool llama_model::pgrn_compact_enabled() const {
+    return pimpl->pgrn_compact != nullptr;
