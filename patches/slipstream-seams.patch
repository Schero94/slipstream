+struct common_speculative_impl_draft_ane : public common_speculative_impl {
+    common_params_speculative_ane params;
+#if defined(__APPLE__)
+    pgr_ane * adapter = nullptr;
+    pgr_ane_info info{};
+#endif
+    std::vector<int32_t> input;
+
+    common_speculative_impl_draft_ane(const common_params_speculative & params, uint32_t n_seq)
+        : common_speculative_impl(COMMON_SPECULATIVE_TYPE_DRAFT_ANE, n_seq, params.draft.n_max), params(params.ane) {
+#if defined(__APPLE__)
+        if (this->params.manifest_path.empty() || this->params.target_model_sha256.size() != 64 ||
+                this->params.target_architecture.empty() || this->params.target_n_vocab <= 0 ||
+                this->params.budget_bytes == 0) {
+            throw std::runtime_error("ANE draft identity or budget is unavailable");
+        }
+        pgr_ane_manifest_params manifest_params{};
+        manifest_params.manifest_path = this->params.manifest_path.c_str();
+        manifest_params.expected_model_sha256 = this->params.target_model_sha256.c_str();
+        manifest_params.expected_architecture = this->params.target_architecture.c_str();
+        manifest_params.expected_vocabulary = static_cast<uint32_t>(this->params.target_n_vocab);
+        manifest_params.allocation_budget_bytes = this->params.budget_bytes;
+        char error[256] = {};
+        adapter = pgr_ane_new_from_manifest(&manifest_params, &info, error, sizeof(error));
+        if (!adapter) throw std::runtime_error(std::string("ANE draft admission failed: ") + error);
+        input.resize(info.input_count, info.pad_token);
+        SPC_INF("ANE one-shot draft admitted: input=%zu candidates=%zu budget=%.2f MiB\n",
+                info.input_count, info.candidate_count, this->params.budget_bytes / 1048576.0);
+#else
+        GGML_UNUSED(params);
+        GGML_UNUSED(n_seq);
+        throw std::runtime_error("ANE draft requires macOS Core ML");
+#endif
+    }
+
+    ~common_speculative_impl_draft_ane() override {
+#if defined(__APPLE__)
+        pgr_ane_free(adapter);
+#endif
+    }
+
+    void begin(llama_seq_id, const llama_tokens &) override {}
+    bool process(const common_batch &) override { return true; }
+
+    void draft(common_speculative_draft_params_vec & dparams) override {
+#if defined(__APPLE__)
+        for (auto & dp : dparams) {
+            if (!dp.drafting || !dp.prompt || !dp.result) continue;
+            std::fill(input.begin(), input.end(), info.pad_token);
+            const size_t history_count = dp.prompt->size();
+            const bool append_last = history_count == 0 || dp.prompt->back() != dp.id_last;
+            const size_t total = history_count + (append_last ? 1 : 0);
+            const size_t keep = std::min(total, input.size());
+            const size_t first = total - keep;
+            for (size_t i = 0; i < keep; ++i) {
+                const size_t source = first + i;
+                input[input.size() - keep + i] = source < history_count ? (*dp.prompt)[source] : dp.id_last;
+            }
+            const int32_t * candidates = nullptr;
+            size_t candidate_count = 0;
+            char error[256] = {};
+            if (pgr_ane_propose(adapter, input.data(), input.size(), &candidates,
+                        &candidate_count, error, sizeof(error)) != 0) {
+                SPC_WRN("ANE proposal failed closed: %s\n", error);
+                continue;
+            }
+            const size_t limit = std::min(candidate_count,
+                    static_cast<size_t>(dp.n_max > 0 ? dp.n_max : candidate_count));
+            bool valid = true;
+            for (size_t i = 0; i < limit; ++i) {
+                if (candidates[i] < 0 || candidates[i] >= this->params.target_n_vocab) {
+                    valid = false;
+                    break;
+                }
+            }
+            if (!valid) {
+                SPC_WRN("%s", "ANE proposal contained an out-of-vocabulary token; discarded\n");
+                continue;
+            }
+            dp.result->insert(dp.result->end(), candidates, candidates + limit);
+        }
+#else
+        GGML_UNUSED(dparams);
+#endif
+    }
+
+    void accept(llama_seq_id, uint16_t, bool) override {}
+};
