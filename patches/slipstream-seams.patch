+static uint64_t parse_pgrn_gib(const std::string & value) {
+    size_t consumed = 0;
+    const double gib = std::stod(value, &consumed);
+    constexpr double bytes_per_gib = 1024.0 * 1024.0 * 1024.0;
+    if (consumed != value.size() || !std::isfinite(gib) || gib <= 0.0 ||
+            gib > (double) UINT64_MAX / bytes_per_gib) {
+        throw std::invalid_argument("PGRN budget must be a positive number of GiB");
+    }
+    const double bytes = gib * bytes_per_gib;
+    if (bytes < 1.0 || bytes > (double) UINT64_MAX) {
+        throw std::invalid_argument("PGRN budget is outside the uint64 byte range");
+    }
+    return (uint64_t) bytes;
+}
+
+static uint64_t parse_pgrn_uint(
+        const std::string & value, const char * label, uint64_t minimum, uint64_t maximum) {
+    size_t consumed = 0;
+    uint64_t parsed = 0;
+    if (value.empty() || value[0] == '-') {
+        throw std::invalid_argument(string_format("%s must be between %llu and %llu", label,
+                (unsigned long long) minimum, (unsigned long long) maximum));
+    }
+    try {
+        parsed = std::stoull(value, &consumed, 10);
+    } catch (const std::exception &) {
+        throw std::invalid_argument(string_format("%s must be between %llu and %llu", label,
+                (unsigned long long) minimum, (unsigned long long) maximum));
+    }
+    if (consumed != value.size() || parsed < minimum || parsed > maximum) {
+        throw std::invalid_argument(string_format("%s must be between %llu and %llu", label,
+                (unsigned long long) minimum, (unsigned long long) maximum));
+    }
+    return parsed;
+}
