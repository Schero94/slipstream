+static bool llama_pgrn_tensor_layer(const char * name, uint16_t * layer, bool * compact) {
+    static const char topk_prefix[] = "ffn_moe_topk-";
+    static const char slot_prefix[] = "pgrn_moe_slots-";
+    if (!name || !layer || !compact) return false;
+    const char * start = std::strstr(name, topk_prefix);
+    size_t prefix_size = sizeof(topk_prefix);
+    *compact = false;
+    if (!start) {
+        start = std::strstr(name, slot_prefix);
+        prefix_size = sizeof(slot_prefix);
+        *compact = true;
+    }
+    if (!start) return false;
+    start += prefix_size - 1;
+    if (*start < '0' || *start > '9') return false;
+    uint32_t value = 0;
+    for (const char * cursor = start; *cursor; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') return false;
+        const uint32_t digit = (uint32_t) (*cursor - '0');
+        if (value > (UINT16_MAX - digit) / 10U) return false;
+        value = value * 10U + digit;
+    }
+    *layer = (uint16_t) value;
+    return true;
+}
+
+bool llama_context::pgrn_eval_callback(ggml_tensor * tensor, bool ask, void * user_data) {
+    return user_data ? static_cast<llama_context *>(user_data)->pgrn_eval(tensor, ask) : false;
+}
+
+bool llama_context::pgrn_eval(ggml_tensor * tensor, bool ask) {
+    uint16_t layer = 0;
+    bool compact = false;
+    const bool is_pgrn = tensor && llama_pgrn_tensor_layer(tensor->name, &layer, &compact);
+    if (ask) {
+        const bool user_wants = cparams.cb_eval && cparams.cb_eval(tensor, true, cparams.cb_eval_user_data);
