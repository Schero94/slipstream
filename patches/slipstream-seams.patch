+// Response-level adaptive draft controller. The state is owned by a server
+// slot, survives individual requests, and is reset when the server session
+// starts. Fixed speculative decoding never constructs or consults it.
+struct common_speculative_adaptive_draft {
+    static constexpr int32_t n_min = 4;
+    static constexpr int32_t n_max = 12;
+    static constexpr int32_t n_start = 8;
+    static constexpr float alpha = 0.25f;
+
+    int32_t current = n_start;
+    float ewma = -1.0f;
+
+    int32_t last_used = 0;
+    int32_t last_next = 0;
+    float last_acceptance = -1.0f;
+
+    void reset();
+    void observe(int32_t generated, int32_t accepted);
+};
