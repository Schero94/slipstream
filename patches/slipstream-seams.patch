+const char * llama_context::lm_ineligible(const llama_batch_ext & batch_inp, llama_memory_context_i * mctx, bool has_embd_row,
+        bool has_state_row, bool write_h_nextn, bool has_samplers) const {
+    if (!lm_enabled || lm_resid == nullptr || !model.supports_layer_range()) {
+        return "disabled";
+    }
+    const uint32_t n_tokens = balloc->get_n_tokens();
+    if (n_tokens <= (lm_min_ubatches - 1) * cparams.n_ubatch) {
+        return "fewer than PGRN_LAYER_MAJOR_MIN_UBATCHES ubatches";
+    }
+    if ((int64_t) n_tokens > lm_resid->ne[1]) {
+        return "batch larger than the residual buffer (PGRN_LAYER_MAJOR_MAX_TOKENS)";
+    }
+    if (cparams.ctx_type != LLAMA_CONTEXT_TYPE_DEFAULT || !cparams.causal_attn || cparams.embeddings) {
+        return "not a causal decoder context without embeddings";
+    }
+    if (cparams.embeddings_nextn || write_h_nextn || has_state_row) {
+        return "MTP hidden-state extraction (embeddings_nextn)";
+    }
+    if (cparams.embeddings_layer_inp_dev || layer_inp_dev != nullptr || has_embd_row) {
+        return "layer input extraction / injection";
+    }
+    for (bool v : cparams.embeddings_layer_inp) {
+        if (v) {
+            return "layer input extraction";
+        }
+    }
+    if (has_samplers) {
+        return "backend samplers";
+    }
+    if (batch_inp.n_embd > 0) {
+        return "embedding input";
+    }
+    // one sequence: every token belongs to exactly the same single sequence
+    llama_seq_id seq = -1;
+    for (const auto & tok : batch_inp.tokens) {
+        if (tok.seq_ids.size() != 1 || tok.has_embd || tok.has_state) {
+            return "a token with several sequences or an embedding";
+        }
+        const llama_seq_id s = *tok.seq_ids.begin();
+        if (seq < 0) {
+            seq = s;
+        } else if (s != seq) {
+            return "more than one sequence in the batch";
+        }
+    }
+    if (!mctx->lm_supported()) {
+        return "memory cannot rewind (n_rs_seq > 0, rs_replay or shared cells)";
+    }
+    return nullptr;
+}
+
+int llama_context::lm_fail(llama_memory_context_i * mctx, ggml_status status, bool touched) {
+    // the previous (layer, ubatch) step may still be in flight on the GPU (graph compute is asynchronous): wait for
+    // it before the scratch hold is released and the memory is rewound / removed under it
+    ggml_backend_sched_synchronize(sched.get());
+    // layers already processed parts of this batch while the metadata may say otherwise, and recurrent
+    // state cannot be removed partially: drop the whole sequence. Nothing ran yet (an abort before the first
+    // graph): the rewind alone restores the memory exactly as it was before this call.
+    mctx->lm_rewind();
+    if (touched && lm_seq >= 0) {
+        LLAMA_LOG_WARN("%s: layer-major decode failed, removing all memory of seq_id = %d\n", __func__, lm_seq);
+        memory->seq_rm(lm_seq, -1, -1);
+    }
+    lm_end();
+    switch (status) {
+        case GGML_STATUS_ABORTED:      return  2;
+        case GGML_STATUS_ALLOC_FAILED: return -2;
+        default:                       return -3;
+    }
+}
+
+void llama_context::lm_end() {
+    lm_active         = false;
+    lm_progress_total = 0;
+    lm_seq    = -1;
+    lm_il0    = 0;
+    lm_il1    = -1;
+    model.pgrn_scratch_hold(-1);
+}
