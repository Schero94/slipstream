+
+void llama_model::pgrn_prefetch_list(uint16_t layer, const int32_t * experts, size_t n) const {
+    if (!pgrn_enabled() || !experts || n == 0) return;
+    uint16_t list[256];
+    int m = 0;
+    for (size_t i = 0; i < n && m < 256; ++i) {
+        const int32_t v = experts[i];
+        if (v < 0 || v > 0xFFFF) continue;
+        bool dup = false;
+        for (int k = 0; k < m; ++k) if (list[k] == (uint16_t) v) { dup = true; break; }
+        if (!dup) list[m++] = (uint16_t) v;
+    }
+    pgr_runtime_prefetch_kick_list(pimpl->pgrn_runtime, layer, list, m);
+}
