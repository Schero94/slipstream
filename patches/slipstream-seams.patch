+@ModelBase.register("DFlashLagunaForCausalLM")
+class DFlashLagunaModel(DFlashModel):
+    """Laguna DFlash drafter (e.g. poolside/Laguna-XS-2.1-DFlash).
+
+    Dense Laguna-style draft layers on top of the generic DFlash contract:
+    fused qkv_proj (split here), per-head/per-element g_proj attention gate,
+    per-aux-layer RMSNorms (aux_hidden_norms) applied before concat + fc, and a
+    causal noise block. The GGUF is marked with decoder_arch = "laguna" so the
+    runtime picks the Laguna draft-layer contract. No embeddings or lm_head:
+    the drafter shares them with the target at runtime.
+    """
+
+    model_arch = gguf.MODEL_ARCH.DFLASH
+
+    def set_gguf_parameters(self) -> None:
+        # transformers' LagunaConfig injects MoE defaults (num_experts_per_tok)
+        # into the dense drafter config (num_experts == 0). Drop the expert keys
+        # so the GGUF does not carry an expert_count=0 / expert_used_count>0
+        # pair, which the runtime rejects.
+        if not self.hparams.get("num_experts") and not self.hparams.get("num_local_experts"):
+            for k in ("num_experts", "num_local_experts", "num_experts_per_tok", "num_experts_per_token"):
+                self.hparams.pop(k, None)
+        super().set_gguf_parameters()
+        self.gguf_writer.add_decoder_arch("laguna")
+
+    _aux_norms: dict[int, Tensor] | None = None
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        # per-aux feature norms: stack model.aux_hidden_norms.{k}.weight into a
+        # single [n_aux, n_embd] tensor once all of them have been seen
+        m = re.fullmatch(r"model\.aux_hidden_norms\.(\d+)\.weight", name)
+        if m:
+            if self._aux_norms is None:
+                self._aux_norms = {}
+            self._aux_norms[int(m.group(1))] = data_torch
