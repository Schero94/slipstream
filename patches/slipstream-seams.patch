+int llama_context::lm_fail(llama_memory_context_i * mctx, ggml_status status, bool touched) {
+    // the previous (layer, ubatch) step may still be in flight on the GPU (graph compute is asynchronous): wait for
+    // it before the scratch hold is released and the memory is rewound / removed under it
+    ggml_backend_sched_synchronize(sched.get());
+    // layers already processed parts of this batch while the metadata may say otherwise, and recurrent
+    // state cannot be removed partially: drop the whole sequence. Nothing ran yet (an abort before the first
+    // graph): the rewind alone restores the memory exactly as it was before this call.
+    mctx->lm_rewind();
+    if (touched && lm_seq >= 0) {
+        LLAMA_LOG_WARN("%s: layer-major decode failed, removing all memory of seq_id = %d\n", __func__, lm_seq);
+        memory->seq_rm(lm_seq, -1, -1);
+    }
+    lm_end();
+    switch (status) {
+        case GGML_STATUS_ABORTED:      return  2;
+        case GGML_STATUS_ALLOC_FAILED: return -2;
+        default:                       return -3;
+    }
+}
