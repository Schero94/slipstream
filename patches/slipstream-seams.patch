+ggml_tensor * llama_model::pgrn_compact_tensor(uint16_t layer, int role) const {
+    return pimpl->pgrn_compact ? pgr_compact_tensor(pimpl->pgrn_compact, layer, role) : nullptr;
+}
+
+size_t llama_model::pgrn_compact_capacity(uint16_t layer) const {
+    ggml_tensor * tensor = pgrn_compact_tensor(layer, PGR_SCRATCH_GATE);
+    return tensor && tensor->ne[2] > 0 ? static_cast<size_t>(tensor->ne[2]) : 0;
