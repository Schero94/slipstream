+
+void llama_model::pgrn_steer_refresh() const {
+    if (!pgrn_enabled() || !pimpl->pgrn_steer_t) return;
+    const int n_expert = (int) hparams.n_expert;
+    const float bonus = pimpl->pgrn_steer;
+    for (uint32_t il = 0; il < hparams.n_layer_all; ++il) {
+        float * row = pimpl->pgrn_steer_host.data() + (size_t) il * n_expert;
+        if (pgr_runtime_resident_mask(pimpl->pgrn_runtime, (uint16_t) il,
+                    pimpl->pgrn_steer_mask.data(), n_expert) < 0) {
+            std::fill(row, row + n_expert, 0.0f);
+            continue;
+        }
+        for (int e = 0; e < n_expert; ++e) row[e] = pimpl->pgrn_steer_mask[e] ? bonus : 0.0f;
+    }
+    ggml_backend_tensor_set(pimpl->pgrn_steer_t, pimpl->pgrn_steer_host.data(), 0,
+            ggml_nbytes(pimpl->pgrn_steer_t));
+}
+
+void llama_model::pgrn_steer_mark(uint16_t layer, const int32_t * experts, size_t n) const {
+    if (!pgrn_enabled() || !pimpl->pgrn_steer_t || !pimpl->pgrn_steer_la || !experts) return;
+    const int n_expert = (int) hparams.n_expert;
+    if (layer >= hparams.n_layer_all) return;
+    float * row = pimpl->pgrn_steer_host.data() + (size_t) layer * n_expert;
+    bool changed = false;
+    for (size_t i = 0; i < n; ++i) {
+        const int32_t e = experts[i];
+        if (e < 0 || e >= n_expert || row[e] != 0.0f) continue;
+        row[e] = pimpl->pgrn_steer;
+        changed = true;
+    }
+    if (changed) {
+        const size_t row_bytes = (size_t) n_expert * sizeof(float);
+        ggml_backend_tensor_set(pimpl->pgrn_steer_t, row, (size_t) layer * row_bytes, row_bytes);
+    }
+}
