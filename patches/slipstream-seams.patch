+int common_sampler_forced_draft(
+        struct common_sampler    * gsmpl,
+        const struct llama_vocab * vocab,
+        llama_token              * out,
+        int                        out_cap,
+        int                        max_chars) {
+    if (!gsmpl || !gsmpl->grmr || !vocab || !out || out_cap <= 0 || max_chars <= 0) {
+        return 0;
+    }
+    // Walk the currently-forced structural span (non-mutating; operates on a grammar clone).
+    char bytes[512];
+    if (max_chars > (int) sizeof(bytes)) {
+        max_chars = (int) sizeof(bytes);
+    }
+    const size_t n_bytes = llama_sampler_grammar_forced_span(gsmpl->grmr, bytes, sizeof(bytes), max_chars);
+    if (n_bytes == 0) {
+        return 0;
+    }
+    // Tokenize the forced bytes. The byte/token boundary need not match the model's — the target
+    // verifies every draft, so a tail mismatch only costs a rejected draft, never wrong output.
+    const int n_tok = llama_tokenize(vocab, bytes, (int) n_bytes, out, out_cap,
+                                     /* add_special */ false, /* parse_special */ false);
+    return n_tok > 0 ? n_tok : 0;
+}
