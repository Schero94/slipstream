+void common_speculative_adaptive_draft::reset() {
+    current = n_start;
+    ewma = -1.0f;
+    last_used = 0;
+    last_next = 0;
+    last_acceptance = -1.0f;
+}
+
+void common_speculative_adaptive_draft::observe(int32_t generated, int32_t accepted) {
+    GGML_ASSERT(generated > 0);
+    GGML_ASSERT(accepted >= 0 && accepted <= generated);
+
+    last_used = current;
+    last_acceptance = (float) accepted / (float) generated;
+    ewma = ewma < 0.0f ? last_acceptance : alpha * last_acceptance + (1.0f - alpha) * ewma;
+
+    if (ewma < 0.70f) {
+        current = std::max(n_min, current - 1);
+    } else if (ewma > 0.85f) {
+        current = std::min(n_max, current + 1);
+    }
+    last_next = current;
+}
