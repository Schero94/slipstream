+static std::atomic<uint32_t> g_ggml_speculation_scope_depth{0};
+
+void ggml_speculation_scope_enter(void) {
+    g_ggml_speculation_scope_depth.fetch_add(1, std::memory_order_acq_rel);
+}
+
+void ggml_speculation_scope_leave(void) {
+    const uint32_t previous = g_ggml_speculation_scope_depth.fetch_sub(1, std::memory_order_acq_rel);
+    GGML_ASSERT(previous > 0);
+}
+
+bool ggml_speculation_scope_active(void) {
+    return g_ggml_speculation_scope_depth.load(std::memory_order_acquire) > 0;
+}
