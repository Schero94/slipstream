+bool llama_context::set_layer_major(bool value) {
+    if (value && !model.supports_layer_range()) {
+        return false;
+    }
+    if (lm_enabled == value && (!value || lm_resid != nullptr)) {
+        return true;
+    }
+    lm_enabled = value;
+    return lm_resid_alloc() && lm_enabled == value;
+}
