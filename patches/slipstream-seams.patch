+bool llama_context::lm_resid_alloc() {
+    synchronize();
+
+    lm_resid = nullptr;
+    buf_lm_resid.reset();
+    ctx_lm_resid.reset();
+
+    if (!lm_enabled) {
+        return true;
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ctx_lm_resid.reset(ggml_init(params));
+
+    // the residual rows cap the layer-major batch: PGRN_LAYER_MAJOR_MAX_TOKENS (default 40960) bounds the buffer
+    // (n_embd * rows * 4 bytes, 320 MiB at 2048 x 40960) independently of a huge -b; larger batches run normally
+    const int64_t n_rows = std::min<int64_t>(cparams.n_batch, lm_max_tokens);
+    lm_resid = ggml_new_tensor_2d(ctx_lm_resid.get(), GGML_TYPE_F32, model.hparams.n_embd, n_rows);
+    ggml_set_name(lm_resid, "lm_resid");
+
+    // RAM guard: the buffer must fit next to the PGRN headroom, else layer-major stays off (never fail the context)
+    if (model.pgrn_enabled()) {
+        pgr_system_memory memory{};
+        const uint64_t need = ggml_nbytes(lm_resid) + model.pgrn_headroom_bytes();
+        if (pgr_system_memory_read(&memory) == 0 && memory.available_known && memory.available_bytes < need) {
+            LLAMA_LOG_WARN("%s: layer-major prefill disabled: its %.2f MiB residual buffer does not fit the free RAM "
+                           "(available %.2f MiB, headroom %.2f MiB)\n", __func__, ggml_nbytes(lm_resid) / 1048576.0,
+                           memory.available_bytes / 1048576.0, model.pgrn_headroom_bytes() / 1048576.0);
+            lm_enabled = false;
+            lm_resid   = nullptr;
+            ctx_lm_resid.reset();
+            return false;
+        }
+    }
+
+    ggml_backend_dev_t dev = model.dev_output();
+    auto * buft = dev ? ggml_backend_dev_buffer_type(dev) : ggml_backend_cpu_buffer_type();
+
+    buf_lm_resid.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx_lm_resid.get(), buft));
+    if (!buf_lm_resid) {
+        LLAMA_LOG_WARN("%s: failed to allocate the layer-major residual buffer, layer-major prefill disabled\n", __func__);
+        lm_enabled = false;
+        lm_resid   = nullptr;
+        ctx_lm_resid.reset();
+        return false;
+    }
+
+    LLAMA_LOG_INFO("%s: %10s layer-major residual buffer size = %8.2f MiB\n", __func__,
+            ggml_backend_buffer_name(buf_lm_resid.get()), ggml_backend_buffer_get_size(buf_lm_resid.get())/1024.0/1024.0);
