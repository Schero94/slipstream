+static bool llama_pgrn_tensor_layer(const char * name, uint16_t * layer, bool * compact) {
+    static const char topk_prefix[] = "ffn_moe_topk-";
+    static const char slot_prefix[] = "pgrn_moe_slots-";
+    if (!name || !layer || !compact) return false;
+    const char * start = std::strstr(name, topk_prefix);
+    size_t prefix_size = sizeof(topk_prefix);
+    *compact = false;
+    if (!start) {
+        start = std::strstr(name, slot_prefix);
+        prefix_size = sizeof(slot_prefix);
+        *compact = true;
+    }
+    if (!start) return false;
+    start += prefix_size - 1;
+    if (*start < '0' || *start > '9') return false;
+    uint32_t value = 0;
+    for (const char * cursor = start; *cursor; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') return false;
+        const uint32_t digit = (uint32_t) (*cursor - '0');
+        if (value > (UINT16_MAX - digit) / 10U) return false;
+        value = value * 10U + digit;
+    }
+    *layer = (uint16_t) value;
+    return true;
+}
+
+bool llama_context::pgrn_eval_callback(ggml_tensor * tensor, bool ask, void * user_data) {
+    return user_data ? static_cast<llama_context *>(user_data)->pgrn_eval(tensor, ask) : false;
+}
+
+bool llama_context::pgrn_eval(ggml_tensor * tensor, bool ask) {
+    uint16_t layer = 0;
+    bool compact = false;
+    const bool is_pgrn = tensor && llama_pgrn_tensor_layer(tensor->name, &layer, &compact);
+    if (ask && tensor && !is_pgrn && std::strncmp(tensor->name, "pgrn_lookahead-", 15) == 0) {
+        const int la_layer = std::atoi(tensor->name + 15);
+        if (la_layer >= 0 && (size_t) la_layer < pgrn_la_tensor.size()) pgrn_la_tensor[la_layer] = tensor;
+    }
+    if (ask) {
+        const bool user_wants = cparams.cb_eval && cparams.cb_eval(tensor, true, cparams.cb_eval_user_data);
+        const bool wants = is_pgrn || user_wants;
+        if (wants) {
+            pgrn_pending_tensor = tensor;
+            pgrn_pending_user_callback = user_wants;
+        }
+        return wants;
+    }
+
+    if (tensor != pgrn_pending_tensor) {
+        pgrn_error = "scheduler returned an unexpected PGRN callback tensor";
+        return false;
+    }
+    const bool user_wants = pgrn_pending_user_callback;
+    pgrn_pending_tensor = nullptr;
+    pgrn_pending_user_callback = false;
+
+    if (is_pgrn) {
+        if (tensor->type != GGML_TYPE_I32 || tensor->ne[0] != model.hparams.n_expert_used() ||
+                tensor->ne[1] < 0 || tensor->ne[2] != 1 || tensor->ne[3] != 1 ||
+                tensor->nb[0] != sizeof(int32_t)) {
+            pgrn_error = format("top-k tensor geometry is incompatible with PGRN staging: '%s' type=%s "
+                    "ne=[%lld,%lld,%lld,%lld] nb0=%zu (expected I32 [%u, n_tokens, 1, 1])",
+                    tensor->name, ggml_type_name(tensor->type),
+                    (long long) tensor->ne[0], (long long) tensor->ne[1], (long long) tensor->ne[2], (long long) tensor->ne[3],
+                    tensor->nb[0], (unsigned) model.hparams.n_expert_used());
+            return false;
+        }
+        if (tensor->ne[1] == 0) {
+            // no rows reach this layer's experts in this ubatch: the last layer gathers only the
+            // output rows, and upstream's server submits prompt ubatches without outputs
+            if (layer < pgrn_la_tensor.size()) pgrn_la_tensor[layer] = nullptr;
+            model.pgrn_prefetch_settle(layer); // still join any prefetch aimed at this layer
+            return !user_wants || cparams.cb_eval(tensor, false, cparams.cb_eval_user_data);
+        }
+        const size_t rows = (size_t) tensor->ne[1];
+        const size_t row_ids = (size_t) tensor->ne[0];
+        if (rows > SIZE_MAX / row_ids || rows * row_ids > pgrn_ids.size() ||
+                row_ids > SIZE_MAX / sizeof(int32_t)) {
+            pgrn_error = "top-k tensor exceeds fixed PGRN callback capacity";
+            return false;
+        }
+        const size_t row_bytes = row_ids * sizeof(int32_t);
+        if (tensor->nb[1] < row_bytes) {
+            pgrn_error = "top-k tensor row stride is truncated";
+            return false;
+        }
+        const int64_t read_start = ggml_time_us();
+        ggml_backend_tensor_get_2d(tensor, pgrn_ids.data(), 0, row_bytes,
+                rows, tensor->nb[1], row_bytes);
+        pgrn_topk_read_us += ggml_time_us() - read_start;
+        // Lookahead recall: how many of this layer's routed experts did the previous
+        // layer's lookahead predict? (raw expert ids, before any compact slot remap)
+        if (layer < pgrn_la_pred.size() && !pgrn_la_pred[layer].empty()) {
+            const auto & pred = pgrn_la_pred[layer];
+            for (size_t i = 0; i < rows * row_ids; ++i) {
+                ++pgrn_la_total;
+                if (std::find(pred.begin(), pred.end(), pgrn_ids[i]) != pred.end()) ++pgrn_la_hits;
+            }
+        }
+        // Read this layer's lookahead prediction for layer+1 now (it was computed earlier
+        // in the same split, so no extra GPU sync is needed).
+        std::vector<int32_t> * la_next = nullptr;
+        if (layer < pgrn_la_tensor.size() && pgrn_la_tensor[layer] && layer + 1u < pgrn_la_pred.size()) {
+            ggml_tensor * la = pgrn_la_tensor[layer];
+            pgrn_la_tensor[layer] = nullptr;
+            const size_t la_n = (size_t) ggml_nelements(la);
+            if (la->type != GGML_TYPE_I32 || la_n > 4096 || !ggml_is_contiguous(la)) {
+                static bool warned = false;
+                if (!warned) {
+                    warned = true;
+                    LLAMA_LOG_WARN("%s: PGRN lookahead tensor unreadable (type %d, n %zu, contiguous %d) - prefetch skipped\n",
+                            __func__, (int) la->type, la_n, (int) ggml_is_contiguous(la));
+                }
+            } else {
+                pgrn_la_buf.resize(la_n);
+                ggml_backend_tensor_get(la, pgrn_la_buf.data(), 0, la_n * sizeof(int32_t));
+                la_next = &pgrn_la_pred[layer + 1];
+                la_next->assign(pgrn_la_buf.begin(), pgrn_la_buf.end());
+            }
+        }
+        size_t copied = 0;
+        size_t uploaded = 0;
+        uint64_t fetch_us = 0;
+        uint64_t upload_us = 0;
+        char error[192] = {};
+        // Join any speculative prefetch aimed at THIS layer before staging it (frees the
+        // stream + means its predicted experts are already warm). No-op without a table.
+        const int64_t settle_start = ggml_time_us();
+        model.pgrn_prefetch_settle(layer);
+        pgrn_settle_us += ggml_time_us() - settle_start;
+        const int64_t stage_start = ggml_time_us();
+        int stage_result = 0;
+        if (compact) {
+            stage_result = model.pgrn_resolve_slots(
+                    layer, pgrn_ids.data(), rows * row_ids, &copied, error, sizeof(error));
+            fetch_us = static_cast<uint64_t>(ggml_time_us() - stage_start);
+            if (stage_result == 0) {
+                ggml_backend_tensor_set_2d(tensor, pgrn_ids.data(), 0, row_bytes,
+                        rows, tensor->nb[1], row_bytes);
+            }
+        } else {
+            stage_result = model.pgrn_stage(layer, pgrn_ids.data(), rows * row_ids,
+                    &copied, &uploaded, &fetch_us, &upload_us, error, sizeof(error));
+        }
+        if (stage_result != 0) {
+            pgrn_error = error[0] ? error : "unknown PGRN staging failure";
+            return false;
+        }
+        // Warm the NEXT layer's predicted experts on a background thread, overlapping this
+        // layer's expert GEMM + the next layer's attention. Cache warm only - parity-neutral,
+        // so the compact path's remapped ids here only ever waste a speculative read.
+        if (la_next && !la_next->empty()) {
+            model.pgrn_steer_mark((uint16_t) (layer + 1), la_next->data(), la_next->size());
+            model.pgrn_prefetch_list((uint16_t) (layer + 1), la_next->data(), la_next->size());
+            ++pgrn_la_kicks;
+        } else {
+            model.pgrn_prefetch_kick(layer, pgrn_ids.data(), rows * row_ids);
+        }
+        pgrn_stage_us += ggml_time_us() - stage_start;
+        pgrn_experts_staged += copied;
+        pgrn_bytes_uploaded += uploaded;
+        pgrn_fetch_us += fetch_us;
+        pgrn_upload_us += upload_us;
+    }
+
+    if (user_wants && !cparams.cb_eval(tensor, false, cparams.cb_eval_user_data)) return false;
+    return true;
+}
