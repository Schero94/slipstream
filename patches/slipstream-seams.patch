+// Walk the run of code points where the grammar admits EXACTLY ONE next code point
+// (structural literals: braces, quotes, key names, separators, enum bodies). Works on a
+// CLONE so the live grammar is never mutated. Returns UTF-8 bytes written to `out`.
+// A byte class / negation / "any" / token rule, disagreement between stacks, or an allowed
+// completion (an empty stack) all stop the walk. Intended as a lossless *draft* source: the
+// caller feeds these to the speculative verifier, which still checks them against the target,
+// so a wrong result only wastes drafts and can never change the output.
+size_t llama_grammar_forced_span(const struct llama_grammar * grammar,
+                                 char * out, size_t out_cap, int max_chars) {
+    if (!grammar || !out || out_cap == 0 || max_chars <= 0) return 0;
+    if (grammar->awaiting_trigger)      return 0;  // lazy grammar not yet armed
+    if (grammar->partial_utf8.n_remain) return 0;  // mid multi-byte sequence -> can't force a whole cp
+    struct llama_grammar * g = llama_grammar_clone_impl(*grammar);
+    if (!g) return 0;
+    size_t n = 0;
+    for (int step = 0; step < max_chars; ++step) {
+        const llama_grammar_stacks & stacks = g->stacks;
+        if (stacks.empty()) break;
+        bool     forced = false, unique = true;
+        uint32_t chr = 0;
+        for (const auto & stack : stacks) {
+            if (stack.empty()) { unique = false; break; }                    // completion allowed
+            const llama_grammar_element * pos = stack.back();
+            if (pos->type != LLAMA_GRETYPE_CHAR) { unique = false; break; }   // NOT/ANY/TOKEN -> many
+            const llama_grammar_element * nx = pos + 1;
+            if (nx->type == LLAMA_GRETYPE_CHAR_RNG_UPPER ||
+                nx->type == LLAMA_GRETYPE_CHAR_ALT) { unique = false; break; } // range/alt -> many
+            if (!forced) { chr = pos->value; forced = true; }
+            else if (pos->value != chr) { unique = false; break; }           // stacks disagree
+        }
+        if (!forced || !unique) break;
+        char buf[4];
+        const size_t enc = llama_grammar_utf8_encode(chr, buf);
+        if (enc == 0 || n + enc > out_cap) break;
+        memcpy(out + n, buf, enc);
+        n += enc;
+        llama_grammar_accept(g, chr);
+    }
+    llama_grammar_free_impl(g);
+    return n;
+}
