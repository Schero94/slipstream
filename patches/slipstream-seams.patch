+
+void llama_model::pgrn_prefetch_kick(uint16_t src_layer, const int32_t * fired, size_t n_fired) const {
+    if (!pgrn_enabled()) return;
+    const int nf = n_fired > INT_MAX ? INT_MAX : (int) n_fired;
+    if (pgr_runtime_has_online(pimpl->pgrn_runtime)) {
+        pgr_runtime_prefetch_kick_online(pimpl->pgrn_runtime, src_layer, fired, nf);
+    } else if (pgr_runtime_has_coupling(pimpl->pgrn_runtime)) {
+        pgr_runtime_prefetch_kick_coupled(pimpl->pgrn_runtime, src_layer, fired, nf);
+    } else {
+        pgr_runtime_prefetch_kick(pimpl->pgrn_runtime, (uint16_t) (src_layer + 1));
+    }
